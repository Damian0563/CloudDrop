SECRET=<ARBITRARY SECERET FOR AUTHENTICATION BETWEEN REQUESTS>
AUTHORITY=<URL OF AUTHORITY SERVER>
BUCKET_NAME=<NAME OF BUCKET ON GCP>
GOOGLE_JSON=<STRINGIFIED GCP SERVICE ACCOUNT JSON> i.e has such a form:
  "type": "service_account",
  "project_id": "",
  "private_key_id": "",
  "private_key": "",
  "client_email": "",
  "client_id": "",
  "auth_uri": "",
  "token_uri": "",
  "auth_provider_x509_cert_url": "",
  "client_x509_cert_url": "",
  "universe_domain": ""
}'
